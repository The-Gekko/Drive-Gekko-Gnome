# Maintainer: The-Gekko <thegekko5426@gmail.com>
# Contributor: Drive-Gekko-Gnome
# Basado en el PKGBUILD oficial de Arch (heftig, fabiscafe; licencia 0BSD):
#   https://gitlab.archlinux.org/archlinux/packaging/packages/gnome-online-accounts
# Opcion -D google_files=true tomada de la receta de Solus (MPL-2.0):
#   https://github.com/getsolus/packages/blob/main/packages/g/gnome-online-accounts/package.yml
#   la anadio Joey Riches el 2026-03-21, commit a4be6479d5e3fcc97151a5451a588efd27a04779
#
# ############################################################################
# POR QUE ESTE PAQUETE EXISTE AQUI
#
# Sin esto, gvfs-google NO SIRVE PARA NADA. Es la pieza que falta.
#
# GNOME Online Accounts pide a Google una lista de permisos (scopes) OAuth al
# dar de alta la cuenta. Desde febrero de 2026 upstream metio la parte de
# Drive detras de una opcion de compilacion, apagada por defecto:
#
#   option('google_files', type: 'boolean', value: false,
#          description: 'Enable Google provider Files feature')
#
#   commit: "build: Disable google provider Files feature" (2026-02-19)
#
# Arch compila con el valor por defecto. Resultado: el goa-daemon de [extra] NO
# pide https://www.googleapis.com/auth/drive, la cuenta nunca expone la interfaz
# org.gnome.OnlineAccounts.Files, y gvfsd-google recibe "Permiso denegado"
# aunque este perfectamente instalado.
#
# Solus compila con -Dgoogle_files=true. Por eso alli Drive funciona.
#
# QUE HACE ESTE PAQUETE: el mismo tarball oficial, la misma version que Arch,
# con esa unica opcion activada. Solo reemplaza `gnome-online-accounts`;
# `libgoa` y `libgoa-docs` siguen siendo los oficiales de [extra].
#
# CONSECUENCIA IMPORTANTE: esto SI sombrea un paquete del sistema. Cada vez que
# Arch actualice gnome-online-accounts, pacman instalara el suyo y Drive dejara
# de montar SIN AVISAR (no falla el arranque, solo desaparece el permiso).
# `scripts/check-updates.sh` detecta esa situacion comprobando si el binario
# instalado pide el scope de Drive. Ver docs/mantenimiento.md.
# ############################################################################

pkgname=gnome-online-accounts
pkgver=3.58.1
# REGLA: pkgrel = <pkgrel de Arch>.1  (Arch 3.58.1-1 -> aqui 3.58.1-1.1)
# vercmp: 1.1 > 1 y 1.1 < 2. Asi este paquete SIEMPRE gana al de [extra] en
# version (pacman -U/-S --needed ya no lo omiten), nunca colisiona el nombre del
# fichero en /var/cache/pacman/pkg con el de Arch, y cuando Arch publique -2 el
# sincronizador pasara a -2.1. makepkg admite pkgrel con un punto decimal.
pkgrel=1.1
pkgdesc='Single sign-on framework for GNOME (compilado con -D google_files=true)'
arch=('x86_64')
url='https://gitlab.gnome.org/GNOME/gnome-online-accounts'
license=('LGPL-2.0-or-later')
depends=(
  "libgoa=${pkgver}"   # el oficial de [extra]; este paquete NO lo reemplaza
  'dbus'
  'dconf'
  'gcr-4'
  'glib2'
  'glibc'
  'gtk4'
  'hicolor-icon-theme'
  'json-glib'
  'keyutils'
  'krb5'
  'libadwaita'
  'libgcc'
  'librest'
  'libsecret'
  'libsoup3'
  'libxml2'
)
makedepends=(
  'git'
  'glib2-devel'
  'gobject-introspection'
  'meson'
  'ninja'
  'vala'
  # Lo que pide el meson de GOA 3.58.1 con las opciones de build(). Repetido
  # desde depends a proposito: la instalacion real (scripts/local-repo.sh)
  # construye con `makepkg -d` y solo instala las makedepends, nunca las
  # depends. Lo que falte aqui no se instala jamas por ese camino y meson
  # aborta a mitad, sin el "Missing dependencies" limpio que -d suprime.
  'dbus'         # meson.build:88   dbus-1
  'gcr-4'        # meson.build:190  gcr-4        (proveedor kerberos, activo por defecto)
  'gtk4'         # meson.build:110
  'json-glib'    # meson.build:95   json-glib-1.0
  'keyutils'     # meson.build:192  libkeyutils
  'krb5'         # meson.build:191
  'libadwaita'   # meson.build:122  libadwaita-1
  'librest'      # meson.build:99   rest-1.0
  'libsecret'    # meson.build:96   libsecret-1
  'libsoup3'     # meson.build:97   libsoup-3.0
  'libxml2'      # meson.build:98   libxml-2.0
  # El -D man=true de build() genera goa-daemon.8 con xsltproc, y con --nonet
  # las hojas docbook tienen que estar en disco: doc/meson.build:75-96.
  'docbook-xsl'
  'libxslt'
)
optdepends=(
  # Va primero porque sin el la cadena entera se instala, se verifica y NO
  # sirve: GOA guarda el token con secret_password_store_sync (goautils.c:309)
  # y en Arch el unico org.freedesktop.secrets es el de gnome-keyring. Nada lo
  # arrastra como dependencia dura, ni siquiera gnome-session.
  'gnome-keyring: proveedor de org.freedesktop.secrets; SIN ESTO no se puede anadir la cuenta de Google (GOA no puede guardar el token)'
  'gvfs-google: montar Google Drive en Nautilus (el motivo de este paquete)'
  'gvfs-goa: sistemas de ficheros virtuales, p.ej. OwnCloud'
  'gvfs-onedrive: Microsoft OneDrive'
)
provides=('libgoa-backend-1.0.so')
options=('!emptydirs')

# Los tags de GOA usan firmas SSH que makepkg no entiende; se verifica por b2sum
# del checkout, igual que hace Arch.
source=("git+https://gitlab.gnome.org/GNOME/${pkgname}.git#tag=${pkgver}")
b2sums=('602f36235a44052e0a0b7feea7574f659144bb70f4f97b50c6d020927b6d153290cc0396d38265d20f36a2c2d8f920817c187ef6584279623935c3c9ed74ea8e')

build() {
  # Diferencias con Arch: -D google_files=true (lo que importa) y
  # -D documentation=false (evita gi-docgen; es lo mismo que hace Solus).
  arch-meson "${pkgname}" build \
    -D google_files=true \
    -D documentation=false \
    -D man=true

  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"

  cd "${pkgdir}"

  # Comprobacion ruidosa a proposito: si el binario no acabo pidiendo el scope
  # de Drive, este paquete no sirve y es mejor que el build pare aqui que
  # descubrirlo despues con un "Permiso denegado" sin explicacion.
  # El scope vive en libgoa-backend (goabackend/goagoogleprovider.c), no en el
  # daemon. Se busca con glob para que sobreviva a cambios de soname.
  # grep -a lee el binario directamente: no depende de binutils. El patron
  # exige 'drive' seguido de espacio o fin de linea para no dar por bueno un
  # scope parcial (drive.file, drive.readonly).
  # Ojo con `find -exec ... +`: si el -name no encuentra NADA, grep no llega a
  # ejecutarse y find sale con 0, o sea que el guardian daria por bueno un
  # paquete sin libgoa-backend. Por eso primero se captura el fichero y se
  # comprueba que existe, como ya hace scripts/verify-chain.sh:32-36.
  # `-print -quit` en vez de `| head -1`: para en el primer fichero regular
  # (los otros dos son enlaces del soname) y sin tuberia no hay SIGPIPE que
  # pueda envenenar el estado de salida bajo pipefail.
  # El `|| true` no traga nada: makepkg corre package() con errexit, y sin el
  # un usr/lib inexistente aborta EN la asignacion y el mensaje de abajo no
  # llega a imprimirse nunca. Quien decide sigue siendo el [[ -z ]] de abajo.
  local _lib
  _lib="$(find usr/lib -name 'libgoa-backend-1.0.so*' -type f -print -quit || true)"
  if [[ -z "$_lib" ]]; then
    echo "ERROR: el build no genero ninguna libgoa-backend-1.0.so en usr/lib." >&2
    echo "       sin ella este paquete no aporta nada: revisa la opcion goabackend" >&2
    return 1
  fi
  if ! grep -aqE 'googleapis\.com/auth/drive( |$)' "$_lib"; then
    echo "ERROR: goa-daemon no pide el scope de Drive." >&2
    echo "       revisa si la opcion google_files sigue existiendo en GOA ${pkgver}" >&2
    return 1
  fi

  # Ficheros que pertenecen a los paquetes libgoa/libgoa-docs de [extra]:
  # se eliminan para no entrar en conflicto con ellos.
  rm -rf usr/include/goa-1.0/goa
  rm -f  usr/lib/libgoa-1.0.so*
  rm -f  usr/lib/girepository-1.0/Goa-1.0.typelib
  rm -rf usr/lib/goa-1.0/include
  rm -f  usr/lib/pkgconfig/goa-1.0.pc
  rm -f  usr/share/gir-1.0/Goa-1.0.gir
  rm -f  usr/share/vala/vapi/goa-1.0.*
  rm -rf usr/share/doc

  install -Dm644 "${srcdir}/${pkgname}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
